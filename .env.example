# Prisma datasource URL. The schema uses the SQLite provider by default, so
# the URL must be a `file:` path unless the schema is also switched over.
# Copy this file to .env and update as needed.
DATABASE_URL="file:./dev.db"

# Signing secret for HTTP-only session cookies. Must be >= 16 chars.
SESSION_SECRET="change-me-to-a-long-random-string"

# SMS provider for OTP delivery. "termii" uses TermiiProvider; anything else uses
# an in-memory provider (useful for local dev / tests).
SMS_PROVIDER="memory"
TERMII_API_KEY=""
TERMII_SENDER_ID="Bukay"
# TERMII_BASE_URL="https://api.ng.termii.com"
# TERMII_CHANNEL="generic"
