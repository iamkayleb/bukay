// Bukay booking platform — Prisma schema
// Multi-tenant data model. Every tenant-owned row carries a tenantId column
// and a corresponding @@index([tenantId]) for partition-friendly queries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Tenant {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  timezone        String         @default("Africa/Lagos")
  currency        String         @default("NGN")
  /// Active PaymentProvider adapter name: "paystack" | "flutterwave" | "fake".
  paymentProvider String         @default("paystack")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  users           User[]
  services        Service[]
  staff           Staff[]
  businessHours   BusinessHour[]
  clients         Client[]
  bookings        Booking[]
  payments        Payment[]
  ledgerEntries   LedgerEntry[]
  auditLogs       AuditLog[]
  slotHolds       SlotHold[]
  deadLetters     DeadLetter[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  name      String
  role      String   @default("owner")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Service {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  currency        String     @default("NGN")
  active          Boolean    @default(true)
  bookings        Booking[]
  slotHolds       SlotHold[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Staff {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  active    Boolean   @default(true)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model BusinessHour {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  opensAt   String
  closesAt  String
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

model Client {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String
  notes     String?
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Booking {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId String
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staffId   String?
  staff     Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  startsAt  DateTime
  endsAt    DateTime
  status    String    @default("pending")
  notes     String?
  /// Non-null for active (non-cancelled) bookings. Unique per tenant so the DB
  /// enforces one live reservation per slot. Format: serviceId + '|' + startsAt ISO.
  slotLock  String?
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, slotLock])
  @@index([tenantId])
  @@index([tenantId, startsAt])
  @@index([clientId])
  @@index([serviceId])
  @@index([staffId])
}

/// Durable public-booking slot hold. Source of truth for the 10-minute hold window.
model SlotHold {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  sessionId String
  bookingId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, serviceId, startsAt])
  @@index([tenantId])
  @@index([expiresAt])
  @@index([tenantId, expiresAt])
}

model Payment {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String    @default("NGN")
  provider    String?
  providerRef String?
  status      String    @default("pending")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  ledgerEntries LedgerEntry[]

  @@index([tenantId])
  @@index([bookingId])
  @@index([providerRef])
}

/// Append-only money movement row. Provider adapters write the same shape so
/// switching Tenant.paymentProvider never rewrites historical entries.
model LedgerEntry {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId        String?
  payment          Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  bookingId        String?
  provider         String
  direction        String   @default("credit")
  grossCents       Int
  providerFeeCents Int      @default(0)
  platformFeeCents Int      @default(0)
  netCents         Int
  currency         String   @default("NGN")
  reference        String?
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([paymentId])
  @@index([reference])
  @@index([tenantId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
}

/// Dead-letter queue for events that could not be processed successfully.
/// Used for unknown/unhandled inbound webhooks and permanently failed outbound
/// lifecycle notifications (WhatsApp + SMS exhausted; see app/lib/notifications).
/// Retention: authenticated Paystack webhooks call `purgeExpiredDeadLetters`
/// to delete rows older than 30 days (see app/lib/payments/dead-letter.ts).
model DeadLetter {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  source    String
  eventType String
  payload   String
  reason    String?
  createdAt DateTime @default(now())

  @@index([source])
  @@index([eventType])
  @@index([createdAt])
  @@index([tenantId])
}

/// Durable webhook / request idempotency keys (7-day TTL via expiresAt).
model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

