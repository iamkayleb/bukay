{
  "name": "bukay",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:issue-556:pr-task-1": "vitest run __tests__/app/\\(app\\)/calendar/day-view.test.tsx # issue #556 calendar day empty state",
    "verify:issue-556:pr-task-1": "pnpm test:issue-556:pr-task-1 && vitest run __tests__/app/\\(app\\)/issue-556-real-db.test.tsx -t \"task 1\"",
    "verify:issue-556:pr-tasks-1-6": "pnpm verify:issue-556:pr-task-1 && vitest run __tests__/app/\\(app\\)/issue-556-acceptance.test.ts -t \"PR task\" && vitest run __tests__/app/\\(app\\)/empty-states.test.tsx -t \"renders each page with an empty tenant and asserts each message appears\" && vitest run __tests__/app/\\(app\\)/issue-556-task-checklist.test.ts",
    "verify:issue-556:pr-complete": "pnpm verify:issue-556:pr-tasks-1-6 && pnpm verify:issue-556:acceptance-gate && pnpm vitest run",
    "verify:issue-556:keepalive": "pnpm verify:issue-556:pr-complete",
    "test:issue-556:acceptance-criteria": "vitest run __tests__/app/\\(app\\)/issue-556-acceptance.test.ts __tests__/app/\\(app\\)/issue-556-real-db.test.tsx",
    "test:merchant-empty-states": "vitest run __tests__/app/\\(app\\)/issue-556-acceptance.test.ts __tests__/app/\\(app\\)/issue-556-task-checklist.test.ts __tests__/app/\\(app\\)/issue-556-real-db.test.tsx __tests__/app/\\(app\\)/empty-states.test.tsx __tests__/app/\\(app\\)/calendar/day-view.test.tsx __tests__/app/\\(app\\)/calendar/new-booking-form.test.tsx __tests__/app/\\(app\\)/calendar/page.test.tsx __tests__/app/\\(app\\)/clients/page.test.tsx __tests__/app/\\(app\\)/clients/clients-list.test.tsx __tests__/app/\\(app\\)/today/page.test.tsx __tests__/app/\\(app\\)/merchant-empty-copy.test.ts __tests__/app/\\(app\\)/components/merchant-empty-state.test.tsx __tests__/app/\\(app\\)/payments/page.test.tsx __tests__/app/\\(app\\)/payments/payments-list.test.tsx __tests__/app/\\(app\\)/services/page.test.tsx __tests__/app/\\(app\\)/services/services-list.test.tsx",
    "test:e2e:merchant-empty-states": "playwright test e2e/merchant-empty-states.spec.ts",
    "verify:issue-556:quick": "pnpm test:merchant-empty-states && bash -c '! grep -rn \"Nothing here yet\" app/'",
    "verify:issue-556:acceptance-gate": "pnpm build && pnpm test:issue-556:acceptance-criteria && pnpm vitest run __tests__/app/\\(app\\)/empty-states.test.tsx && bash -c '! grep -rn \"Nothing here yet\" app/'",
    "verify:issue-556": "pnpm build && pnpm test:merchant-empty-states && pnpm vitest run && bash -c '! grep -rn \"Nothing here yet\" app/'",
    "verify:issue-556:e2e": "pnpm verify:issue-556 && pnpm test:e2e:merchant-empty-states",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc.json",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "next": "^14.2.15",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^8",
    "eslint-config-next": "^14.2.15",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^31.0.1",
    "postcss": "^8",
    "prettier": "^3.3.0",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite": "^5.4.21",
    "vitest": "^1.6.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
